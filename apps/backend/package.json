  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.4",
    "@types/jest": "29.5.13",
    "@types/node": "22.7.4",
    "@types/express": "4.17.21",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
